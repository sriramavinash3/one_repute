// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OUTLET
  ADMIN
  SUPER_ADMIN
}

enum EmailStatus {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  BOUNCED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  role             Role              @default(USER)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  emailLogs        EmailLog[]

  @@map("users")
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String   // user email
  tokenHash  String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  identifier String    // user email
  tokenHash  String    @unique
  expires    DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("password_reset_tokens")
}

model TeamInvitation {
  id            String   @id @default(uuid())
  email         String
  workspaceId   String
  workspaceName String
  inviterName   String
  tokenHash     String   @unique
  role          String   @default("member")
  expires       DateTime
  status        String   @default("pending") // pending, accepted, expired
  createdAt     DateTime @default(now())

  @@map("team_invitations")
}

model EmailLog {
  id            String      @id @default(uuid())
  userId        String?
  email         String
  template      String
  provider      String      @default("resend")
  status        EmailStatus @default(QUEUED)
  queueId       String?
  latencyMs     Int?
  failureReason String?
  retries       Int         @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([template])
  @@index([status])
  @@map("email_logs")
}

model Subscription {
  id                String    @id
  customerId        String
  planId            String
  billingCycle      String
  status            String
  currency          String
  renewalDate       DateTime?
  trialStartDate    DateTime?
  trialEndDate      DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("subscriptions")
}

model Plan {
  id                    String  @id
  name                  String
  monthlyPrice          Int
  annualPrice           Int
  currency              String
  razorpayMonthlyPlanId String?
  razorpayAnnualPlanId  String?

  @@map("plans")
}

model Invoice {
  id         String   @id
  customerId String
  amount     Int
  currency   String
  status     String
  issuedAt   DateTime @default(now())

  @@map("invoices")
}

model Payment {
  id             String   @id
  customerId     String
  subscriptionId String
  paymentId      String
  amount         Int
  currency       String
  status         String
  createdAt      DateTime @default(now())

  @@map("payments")
}

model Transaction {
  id          String   @id
  customerId  String
  type        String
  description String
  amount      Int
  currency    String
  createdAt   DateTime @default(now())

  @@map("transactions")
}

model Location {
  id                      String    @id
  name                    String
  googleAccountId         String?
  googleLocationId        String?
  googleRefreshToken      String?
  googleConnectedEmail    String?
  providerType            String    @default("GBP")
  placeId                 String?
  syncCooldownMinutes     Int       @default(180)
  lastReviewFetchAt       DateTime?
  latestReviewTimestamp   DateTime?
  autoResponseEnabled     Boolean   @default(false)
  minRatingForAutoResponse Int       @default(4)
  openaiPrompt            String?
  whatsappNumber          String?
  escalationThreshold     Int       @default(3)
  createdAt               DateTime  @default(now())

  @@map("locations")
}

model Review {
  id                String    @id
  reviewId          String    @unique
  outletId          String
  placeId           String?
  providerSource    String
  providerReviewId  String
  reviewTimestamp   DateTime
  customerName      String
  reviewerPhotoURL  String?
  reviewUrl         String?
  rating            Int
  text              String
  rawName           String?
  status            String    @default("pending")
  aiResponse        String?
  replySuggestion   String?
  repliedAt         DateTime?
  sentiment         String?
  processedAt       DateTime?
  lastProcessedAt   DateTime?
  isDeletedOnSource Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("reviews")
}

model SyncHistory {
  id             String   @id @default(uuid())
  outletId       String
  fetchedCount   Int
  newCount       Int
  processedCount Int
  status         String
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@map("sync_history")
}

model AnalyticsSnapshot {
  id          String   @id @default(uuid())
  outletId    String
  metricDate  DateTime
  metricName  String
  metricValue Float
  createdAt   DateTime @default(now())

  @@map("analytics_snapshots")
}
