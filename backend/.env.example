# ============================================================
# GOOGLE BUSINESS PROFILE API
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============================================================
# OPENAI API
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MAX_TOKENS=150
OPENAI_TEMPERATURE=0.75

# ============================================================
# WHATSAPP INTEGRATION (twilio or 360dialog)
# ============================================================
WHATSAPP_PROVIDER=twilio

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- 360dialog ---
DIALOG360_API_KEY=your_360dialog_api_key_here
DIALOG360_FROM_NUMBER=your_360dialog_from_number_here

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_content_here\n-----END PRIVATE KEY-----\n"

# ============================================================
# APP ENVIRONMENT
# ============================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============================================================
# CRON JOB SCHEDULER
# ============================================================
CRON_SCHEDULE=0 10,15,21 * * *
REVIEW_BATCH_SIZE=30
CRON_LOCK_TTL_MS=240000
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here

# ============================================================
# SCRAPER CONFIG (TEMPORARY)
# ============================================================
SCRAPER_MAX_REVIEWS=15
SCRAPER_COOLDOWN_MINUTES=180
SCRAPER_MAX_HASH_HISTORY=1000
SCRAPER_STOP_ON_EXISTING_COUNT=3
APIFY_TIMEOUT_MS=45000

# ============================================================
# APIFY
# ============================================================
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=your_apify_actor_id_here

# ============================================================
# GOOGLE PLACES API
# ============================================================
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ============================================================
# SECURITY & RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
